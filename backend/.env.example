JWT_REFRESH_EXPIRES="7d"

PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Produção → URL do frontend no Vercel (sem barra no final)
ALLOWED_ORIGIN="http://localhost:5173"

# Pluggy
PLUGGY_CLIENT_ID="seu-client-id-aqui"
PLUGGY_CLIENT_SECRET="seu-client-secret-aqui"
PLUGGY_WEBHOOK_SECRET="cole-aqui-um-token-aleatorio-de-32-mais-caracteres"
