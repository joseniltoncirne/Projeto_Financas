DATABASE_URL="file:./dev.db"
# Produção → "postgresql://user:pass@host:5432/orientador"

JWT_SECRET="sua-chave-secreta-minimo-32-caracteres"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

PORT=3333
HOST=0.0.0.0
NODE_ENV=development

ALLOWED_ORIGIN="http://localhost:5173"

# Pluggy
PLUGGY_CLIENT_ID="seu-client-id-aqui"
PLUGGY_CLIENT_SECRET="seu-client-secret-aqui"
# Token aleatório >= 32 chars. Configure este mesmo valor como header
# Authorization no painel de webhooks do Pluggy. Gerar com:
#   openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET="cole-aqui-um-token-aleatorio-de-32-mais-caracteres"
