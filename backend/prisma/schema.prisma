datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  cpf          String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  incomes         Income[]
  expenses        Expense[]
  balances        Balance[]
  rules           Rule[]
  amountRules     AmountRule[]
  categories      Category[]
  aliases         Alias[]
  refreshTokens   RefreshToken[]
  bankConnections BankConnection[]
  fixedExpenses      FixedExpense[]
  deletedExternalIds DeletedExternalId[]
}

model Income {
  id         String   @id @default(uuid())
  userId     String
  month      String
  name       String
  amount     Float
  bank       String
  dateStr    String?
  externalId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month, bank])
  @@index([userId, externalId])
}

model Expense {
  id         String   @id @default(uuid())
  userId     String
  month      String
  name       String
  amount     Float
  type       String   @default("variavel")
  category   String?
  sector     String   @default("gasto")
  bank       String
  isResgate  Boolean  @default(false)
  isInternal Boolean  @default(false)
  dateStr    String?
  externalId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month, bank])
  @@index([userId, sector])
  @@index([userId, externalId])
}

model Balance {
  id        String   @id @default(uuid())
  userId    String
  month     String
  bank      String
  value     Float
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, bank])
}

model Rule {
  id       String @id @default(uuid())
  userId   String
  memo     String
  category String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, memo])
}

model AmountRule {
  id             String @id @default(uuid())
  userId         String
  normalizedName String
  amount         Float
  category       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName, amount])
}

model Category {
  id      String  @id @default(uuid())
  userId  String
  key     String
  label   String
  color   String?
  isFixed Boolean @default(false)
  budget  Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Alias {
  id             String @id @default(uuid())
  userId         String
  normalizedName String
  alias          String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankConnection {
  id        String    @id @default(uuid())
  userId    String
  itemId    String    @unique
  bank      String
  status    String    @default("ok")
  lastSync  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FixedExpense {
  id           String   @id @default(uuid())
  userId       String
  name         String
  amount       Float?
  active       Boolean  @default(true)
  startMonth   String?
  endMonth     String?
  autoLinkName String?
  createdAt    DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments FixedExpensePayment[]

  @@index([userId])
}

model FixedExpensePayment {
  id             String   @id @default(uuid())
  fixedExpenseId String
  month          String
  expenseId      String?
  autoCreated    Boolean  @default(false)
  createdAt      DateTime @default(now())

  fixedExpense FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)

  @@unique([fixedExpenseId, month])
}

// Registro de transações que vieram do banco e foram excluídas pelo usuário.
// O sync usa essa lista para não re-importar o que o usuário não quer mais.
model DeletedExternalId {
  id           String   @id @default(uuid())
  userId       String
  externalId   String
  kind         String   // 'expense' | 'income'
  name         String
  amount       Float
  bank         String
  dateStr      String?
  month        String
  deletedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId])
}
